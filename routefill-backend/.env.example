# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration (Choose either DATABASE_URL or discrete fields)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=routefill_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_LOGGING=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNC=false

# Authentication (Must be a secure random string >= 32 characters in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT=10000

# CORS & Security (Comma-separated allowed origins or domain in production)
CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

